{
  "name": "codex-terminal-extensions",
  "version": "0.1.1",
  "description": "Custom slash commands, autocomplete, and modular command views for Codex CLI",
  "type": "module",
  "license": "MIT",
  "author": "Cheaux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheaux/codex-command-extensions.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codex-terminal": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "plugins",
    ".agents",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "package:directory": "python3 scripts/package-directory.py"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "string-width": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/Cheaux/codex-command-extensions",
  "bugs": {
    "url": "https://github.com/Cheaux/codex-command-extensions/issues"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "slash-commands",
    "autocomplete",
    "command-extensions",
    "extension-host",
    "terminal"
  ]
}
